# Local environment variables for cbl-api-gateway.
HTTP_ADDR=:8000
METRICS_ADDR=:9200
# REDIS_ADDR is optional: empty - local limiter without a shared counter.
REDIS_ADDR=localhost:6379
BILLING_API_URL=http://localhost:8010
BACKOFFICE_URL=http://localhost:8020
RATE_LIMIT_PER_SEC=100
UPSTREAM_TIMEOUT=10s
